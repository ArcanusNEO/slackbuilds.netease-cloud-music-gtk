#!/bin/sh
PREFIX=@PREFIX@
if [ -x "$PREFIX/bin/glib-compile-schemas" ]; then
  LD_LIBRARY_PATH="$PREFIX/@LIBDIR@" \
    "$PREFIX/bin/glib-compile-schemas" "$PREFIX/share/glib-2.0/schemas"
fi
if [ -x "$PREFIX/bin/gio-querymodules" ]; then
  LD_LIBRARY_PATH="$PREFIX/@LIBDIR@" \
    "$PREFIX/bin/gio-querymodules" "$PREFIX/@LIBDIR@/gio/modules"
fi
if [ -x "$PREFIX/bin/gtk4-update-icon-cache" ]; then
  for theme in Adwaita AdwaitaLegacy; do
    if [ -f "$PREFIX/share/icons/$theme/index.theme" ]; then
      LD_LIBRARY_PATH="$PREFIX/@LIBDIR@" \
        "$PREFIX/bin/gtk4-update-icon-cache" -q -t -f "$PREFIX/share/icons/$theme"
    fi
  done
fi
if [ -x /usr/bin/update-desktop-database ]; then
  /usr/bin/update-desktop-database -q usr/share/applications
fi
if [ -x /usr/bin/gtk-update-icon-cache ]; then
  /usr/bin/gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
fi

#!/bin/bash
# Local Slackware build: private GTK/GStreamer runtime, no system-library upgrade.
# SPDX-License-Identifier: MIT
set -euo pipefail
umask 022

PRGNAM=netease-cloud-music-gtk
VERSION=2.5.4
REVISION=df524aeefe53d7d64ca118305848d5dfeb18a645
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-txz}
ARCH=${ARCH:-$(uname -m)}
CWD=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
TMP=${TMP:-/tmp/SBo}
OUTPUT=${OUTPUT:-/tmp}
SOURCES=${SOURCES:-$CWD/sources}
JOBS=${JOBS:-8}
DOWNLOAD=${DOWNLOAD:-yes}
FETCH_ONLY=${FETCH_ONLY:-no}
OFFLINE=${OFFLINE:-no}
PREFIX=/opt/$PRGNAM
APP_ID=com.gitee.gmg137.NeteaseCloudMusicGtk4

case "$ARCH" in
  x86_64) LIBDIR=lib64; SLKCFLAGS=${SLKCFLAGS:-'-O2 -fPIC'} ;;
  aarch64) LIBDIR=lib64; SLKCFLAGS=${SLKCFLAGS:-'-O2 -fPIC'} ;;
  i?86) ARCH=i586; LIBDIR=lib; SLKCFLAGS=${SLKCFLAGS:-'-O2 -march=i586 -mtune=i686'} ;;
  *) printf 'Unsupported architecture: %s\n' "$ARCH" >&2; exit 1 ;;
esac

need()
{
  command -v "$1" >/dev/null || { printf 'Missing build tool: %s\n' "$1" >&2; exit 1; }
}

for tool in python3 tar curl sha256sum; do need "$tool"; done
mkdir -p "$SOURCES"
while read -r archive checksum url; do
  [[ -z "$archive" || "$archive" == \#* ]] && continue
  if [[ ! -f "$SOURCES/$archive" && -f "$CWD/$archive" ]]; then
    cp "$CWD/$archive" "$SOURCES/$archive"
  fi
  if [[ ! -f "$SOURCES/$archive" ]]; then
    [[ "$DOWNLOAD" == yes && "$OFFLINE" != yes ]] || {
      printf 'Missing source archive: %s/%s\n' "$SOURCES" "$archive" >&2
      exit 1
    }
    curl --fail --location --retry 3 --connect-timeout 30 \
      --output "$SOURCES/$archive.part" "$url"
    mv "$SOURCES/$archive.part" "$SOURCES/$archive"
  fi
  actual=$(sha256sum "$SOURCES/$archive")
  [[ "${actual%% *}" == "$checksum" ]] || {
    printf 'SHA256 mismatch: %s\n' "$archive" >&2
    exit 1
  }
  printf 'Verified %s\n' "$archive"
done < "$CWD/sources.list"
[[ "$FETCH_ONLY" == yes ]] && exit 0

for tool in cc c++ meson ninja pkg-config rustc cargo git patch bison flex \
            msgfmt sassc readelf strip xz; do need "$tool"; done
MAKEPKG=${MAKEPKG:-/sbin/makepkg}
[[ -x "$MAKEPKG" ]] || { printf 'Missing makepkg: %s\n' "$MAKEPKG" >&2; exit 1; }
python3 - <<'PY'
import subprocess
version = subprocess.check_output(['rustc', '--version'], text=True).split()[1]
if tuple(map(int, version.split('-')[0].split('.')[:2])) < (1, 92):
    raise SystemExit('This source snapshot requires Rust >= 1.92')
PY
for dependency in 'gnutls >= 3.7.4' 'gdk-pixbuf-2.0 >= 2.42' \
                  'graphene-gobject-1.0 >= 1.10' 'harfbuzz >= 2.6' \
                  'wayland-protocols >= 1.36' 'libavcodec >= 58.18.100' \
                  'libavformat >= 58.12.100' 'libavfilter >= 7.16.100' \
                  libavutil fontconfig freetype2 fribidi libcurl libxml-2.0 \
                  yaml-0.1 libffi libpcre2-8 epoxy xkbcommon x11 xi \
                  libmpg123 libpulse flac ogg vorbis opus alsa openssl dbus-1; do
  pkg-config --exists "$dependency" || {
    printf 'Missing or too old system development dependency: %s\n' "$dependency" >&2
    exit 1
  }
done

mkdir -p "$TMP" "$OUTPUT"
WORKDIR=${WORKDIR:-$(mktemp -d "$TMP/$PRGNAM.XXXXXX")}
WORKDIR=$(realpath -m "$WORKDIR")
PKG="$WORKDIR/package-$PRGNAM"
RUNTIME="$PKG$PREFIX"
[[ ! -e "$PKG" ]] || {
  printf 'Package staging directory already exists; choose a fresh WORKDIR: %s\n' "$PKG" >&2
  exit 1
}
mkdir -p "$WORKDIR/src" "$WORKDIR/build" "$WORKDIR/logs" "$RUNTIME"
printf 'Build directory: %s\n' "$WORKDIR"

while read -r archive checksum url; do
  [[ -z "$archive" || "$archive" == \#* ]] && continue
  tar --extract --file "$SOURCES/$archive" --directory "$WORKDIR/src" --no-same-owner
done < "$CWD/sources.list"
APP_SOURCE="$WORKDIR/src/$PRGNAM-$REVISION"
install -m 644 "$CWD/Cargo.lock" "$APP_SOURCE/Cargo.lock"
patch --directory="$APP_SOURCE" -p1 < "$CWD/private-appearance.patch"

export PATH="$RUNTIME/bin:$PATH"
export PKG_CONFIG_PATH="$RUNTIME/$LIBDIR/pkgconfig:$RUNTIME/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="$RUNTIME/$LIBDIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$RUNTIME/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export CCACHE_DIR=${CCACHE_DIR:-$WORKDIR/ccache}
export CFLAGS="$SLKCFLAGS"
export CXXFLAGS="$SLKCFLAGS"
export CARGO_HOME=${CARGO_HOME:-$SOURCES/cargo-home}
export CARGO_BUILD_JOBS="$JOBS"
export CARGO_TARGET_DIR="$WORKDIR/build/player/target"
export RUSTFLAGS="${RUSTFLAGS:-} -C link-arg=-Wl,-rpath,$PREFIX/$LIBDIR"
[[ "$OFFLINE" == yes ]] && export CARGO_NET_OFFLINE=true

build_meson()
{
  local name="$1"
  shift
  printf '\nBuilding %s\n' "$name"
  (
    meson setup "$WORKDIR/build/$name" "$WORKDIR/src/$name" \
      --prefix="$PREFIX" --libdir="$LIBDIR" --buildtype=release \
      --wrap-mode=nofallback -Ddefault_library=shared \
      "-Dc_link_args=-Wl,-rpath,$PREFIX/$LIBDIR" \
      "-Dcpp_link_args=-Wl,-rpath,$PREFIX/$LIBDIR" "$@"
    meson compile -C "$WORKDIR/build/$name" -j "$JOBS"
    meson install -C "$WORKDIR/build/$name" --no-rebuild --destdir "$PKG"
  ) > "$WORKDIR/logs/$name.log" 2>&1 || {
    printf 'Build failed; see %s/logs/%s.log\n' "$WORKDIR" "$name" >&2
    exit 1
  }
  python3 "$CWD/stage-tools.py" relocate-pc "$RUNTIME" "$PREFIX" "$LIBDIR"
}

build_meson glib-2.80.5 -Dintrospection=disabled -Dtests=false \
  -Dman-pages=disabled -Ddocumentation=false
build_meson wayland-1.26.0 -Dtests=false -Ddocumentation=false -Ddtd_validation=false
build_meson pango-1.52.2 -Dintrospection=disabled -Dgtk_doc=false
build_meson cairo-1.18.4 -Dtests=disabled -Dgtk_doc=false
build_meson gtk-4.16.13 -Dintrospection=disabled -Dvulkan=disabled \
  -Dmedia-gstreamer=disabled -Dprint-cups=disabled -Dbuild-tests=false \
  -Dbuild-testsuite=false -Dbuild-examples=false -Dbuild-demos=false
build_meson adwaita-icon-theme-legacy-46.2
build_meson adwaita-icon-theme-47.0
build_meson libxmlb-0.3.21 -Dgtkdoc=false -Dintrospection=false -Dtests=false
build_meson AppStream-1.0.3 -Dsystemd=false -Dapidocs=false -Dinstall-docs=false \
  -Dstemming=false -Dsvg-support=false -Dgir=false
build_meson libadwaita-1.6.5 -Dintrospection=disabled -Dvapi=false -Dtests=false -Dexamples=false
build_meson glib-networking-2.80.1 -Dlibproxy=disabled -Dgnome_proxy=disabled \
  -Denvironment_proxy=enabled
build_meson gstreamer-1.24.12 -Dintrospection=disabled -Dtests=disabled \
  -Dexamples=disabled -Dbenchmarks=disabled -Ddoc=disabled -Dptp-helper=disabled
build_meson gst-plugins-base-1.24.12 --auto-features=disabled \
  -Dapp=enabled -Daudioconvert=enabled -Daudioresample=enabled -Daudiotestsrc=enabled \
  -Dplayback=enabled -Dtypefind=enabled -Dvolume=enabled -Dgio=enabled \
  -Dencoding=enabled -Drawparse=enabled -Dogg=enabled -Dvorbis=enabled \
  -Dopus=enabled -Dalsa=enabled -Dtools=enabled
build_meson gst-plugins-good-1.24.12 --auto-features=disabled \
  -Daudiofx=enabled -Daudioparsers=enabled -Dautodetect=enabled -Did3demux=enabled \
  -Dicydemux=enabled -Disomp4=enabled -Dmatroska=enabled -Dwavparse=enabled \
  -Dwavenc=enabled -Dsoup=enabled -Dmpg123=enabled -Dpulse=enabled -Dflac=enabled
build_meson gst-plugins-bad-1.24.12 --auto-features=disabled -Dtools=enabled
build_meson gst-libav-1.24.12 --auto-features=disabled

# Cargo's Git dependency and registry crates are cached outside the package tree.
cargo fetch --locked --manifest-path "$APP_SOURCE/Cargo.toml" \
  > "$WORKDIR/logs/cargo-fetch.log" 2>&1
# Upstream's Meson target invokes cargo; require the supplied lock file there too.
python3 - "$APP_SOURCE/build-aux/cargo.sh" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
path.write_text(path.read_text().replace('cargo build --manifest-path',
                                       'cargo build --locked --manifest-path'))
PY
(
  meson setup "$WORKDIR/build/player" "$APP_SOURCE" \
    --prefix="$PREFIX" --libdir="$LIBDIR" --buildtype=release
  meson compile -C "$WORKDIR/build/player"
  meson test -C "$WORKDIR/build/player" --no-rebuild --print-errorlogs
  meson install -C "$WORKDIR/build/player" --no-rebuild --destdir "$PKG"
) > "$WORKDIR/logs/player.log" 2>&1 || {
  printf 'Player build failed; see %s/logs/player.log\n' "$WORKDIR" >&2
  exit 1
}

# Reuse the installed Fcitx5 integration module if present (same GTK4 ABI).
FCITX_MODULE=${FCITX_MODULE:-/usr/$LIBDIR/gtk-4.0/4.0.0/immodules/libim-fcitx5.so}
if [[ "$FCITX_MODULE" != no && -f "$FCITX_MODULE" ]]; then
  install -Dm 755 "$FCITX_MODULE" \
    "$RUNTIME/$LIBDIR/gtk-4.0/4.0.0/immodules/libim-fcitx5.so"
fi

# Desktop integration is public; the libraries/resources remain in /opt.
install -Dm 644 "$WORKDIR/build/player/data/$APP_ID.desktop" \
  "$PKG/usr/share/applications/$APP_ID.desktop"
install -Dm 644 "$WORKDIR/build/player/data/$APP_ID.metainfo.xml" \
  "$PKG/usr/share/metainfo/$APP_ID.metainfo.xml"
for kind in scalable symbolic; do
  if [[ "$kind" == scalable ]]; then icon="$APP_ID.svg"; else icon="$APP_ID-symbolic.svg"; fi
  install -Dm 644 "$APP_SOURCE/data/icons/hicolor/$kind/apps/$icon" \
    "$PKG/usr/share/icons/hicolor/$kind/apps/$icon"
done
mkdir -p "$PKG/usr/bin" "$PKG/install" "$PKG/usr/doc/$PRGNAM-$VERSION"
python3 - "$CWD" "$PKG" "$PREFIX" "$LIBDIR" <<'PY'
from pathlib import Path
import sys
cwd, pkg = map(Path, sys.argv[1:3])
prefix, libdir = sys.argv[3:]
for source, destination in (
        ('netease-cloud-music-gtk4.in', 'usr/bin/netease-cloud-music-gtk4'),
        ('doinst.sh.in', 'install/doinst.sh')):
    text = (cwd / source).read_text().replace('@PREFIX@', prefix).replace('@LIBDIR@', libdir)
    path = pkg / destination
    path.write_text(text)
    path.chmod(0o755)
PY
install -m 644 "$CWD/slack-desc" "$PKG/install/slack-desc"
install -m 644 "$CWD/README" "$CWD/$PRGNAM.SlackBuild" "$CWD/sources.list" \
  "$CWD/Cargo.lock" "$CWD/private-appearance.patch" "$APP_SOURCE/COPYING" \
  "$PKG/usr/doc/$PRGNAM-$VERSION/"

# Keep the bundled libraries' own license notices with the package documentation.
mkdir -p "$PKG/usr/doc/$PRGNAM-$VERSION/licenses"
for source in "$WORKDIR"/src/*; do
  [[ -d "$source" ]] || continue
  for license in "$source"/COPYING* "$source"/LICENSE*; do
    [[ -f "$license" ]] || continue
    install -m 644 "$license" \
      "$PKG/usr/doc/$PRGNAM-$VERSION/licenses/$(basename "$source")-$(basename "$license")"
  done
done

# These caches contain no build-directory paths. Never package a GStreamer registry.
"$RUNTIME/bin/glib-compile-schemas" --strict "$RUNTIME/share/glib-2.0/schemas"
"$RUNTIME/bin/gio-querymodules" "$RUNTIME/$LIBDIR/gio/modules"
for theme in Adwaita AdwaitaLegacy; do
  "$RUNTIME/bin/gtk4-update-icon-cache" -q -t -f "$RUNTIME/share/icons/$theme"
done
python3 "$CWD/stage-tools.py" prune "$RUNTIME" "$LIBDIR"
python3 "$CWD/stage-tools.py" check-elf "$RUNTIME" "$WORKDIR"

# Modern makepkg works unprivileged; normalize ownership in the archive itself.
PACKAGE="$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
(
  export TAR_OPTIONS="${TAR_OPTIONS:-} --owner=0 --group=0 --numeric-owner"
  cd "$PKG"
  "$MAKEPKG" -p -l y -c n "$PACKAGE"
) > "$WORKDIR/logs/makepkg.log" 2>&1
printf '\nPackage: %s\nBuild logs: %s/logs\n' "$PACKAGE" "$WORKDIR"
